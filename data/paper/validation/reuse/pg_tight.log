theorem LeanPEP.ActualFunction.PGOneCapturedTightness.finite_universal_upper : ∀ (d : GramPEP.DataR (Fin 5) 5),
  GramPEP.IsGramPosSemidef d.gram →
    GramPEP.AssumptionsFeasibleR (Profiles.ProximalGradient.modelQ 0) d →
      (Profiles.ProximalGradient.objectiveQ 0).evalR d ≤ 1 / 4 :=
fun d hp ha =>
