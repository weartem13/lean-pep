      C14PGOneUpper.policyQ C14PGOneUpper.rawUpperQ C14PGOneUpper.structuredUpperQ C14PGOneUpper.structured_check)
    fun c h =>
    And.casesOn h fun hc right =>
      And.casesOn right fun hi right =>
        And.casesOn right fun ho hb =>
          have h := Profiles.ProximalGradient.certificate_upper c hc hi ho d hp ha;
          Eq.mpr
            (id
              (Eq.trans
                (Eq.trans
                  (Eq.trans
                    (congrArg (LE.le ((Profiles.ProximalGradient.objectiveQ 0).evalR d))
                      (Mathlib.Meta.NormNum.IsNNRat.to_eq
