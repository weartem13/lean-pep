theorem LeanPEP.ActualFunction.PGOneCapturedTightness.external_primal_attainment : GramPEP.IsGramPosSemidef
    (GramPEP.castDataQ externalPrimalQ).gram ∧
  GramPEP.AssumptionsFeasibleR (Profiles.ProximalGradient.modelQ 0) (GramPEP.castDataQ externalPrimalQ) ∧
    (Profiles.ProximalGradient.objectiveQ 0).evalR (GramPEP.castDataQ externalPrimalQ) = 1 / 4 :=
have hf := C14PGOnePrimal.finite_primal_verified;
have hv := C14PGOnePrimal.objective_verified;
⟨hf.left,
  ⟨hf.right,
    Eq.mpr
      (id
        (congr
          (congrArg Eq (GramPEP.LinearExprQ.evalR_castDataQ (Profiles.ProximalGradient.objectiveQ 0) externalPrimalQ))
          (one_div 4)))
      (Eq.mp
        (congr
          (congrArg Eq
            (GramPEP.LinearExprQ.evalR_castDataQ (Profiles.ProximalGradient.objectiveQ 0) C14PGOnePrimal.canonicalQ))
          (Eq.trans (Eq.trans (congrArg Rat.cast (one_div 4)) (Rat.cast_inv 4)) (congrArg Inv.inv (Rat.cast_ofNat 4))))
        (Eq.mp
            (congrArg
              (fun _a =>
                (Profiles.ProximalGradient.objectiveQ 0).evalR (GramPEP.castDataQ C14PGOnePrimal.canonicalQ) = ↑_a ∧
                  0 < ↑_a)
              C14PGOnePrimal.beta_value)
            hv).left)⟩⟩
theorem LeanPEP.ActualFunction.PGOneCapturedTightness.finite_tightness : (∀ (d : GramPEP.DataR (Fin 5) 5),
    GramPEP.IsGramPosSemidef d.gram →
      GramPEP.AssumptionsFeasibleR (Profiles.ProximalGradient.modelQ 0) d →
        (Profiles.ProximalGradient.objectiveQ 0).evalR d ≤ 1 / 4) ∧
  GramPEP.IsGramPosSemidef (GramPEP.castDataQ externalPrimalQ).gram ∧
    GramPEP.AssumptionsFeasibleR (Profiles.ProximalGradient.modelQ 0) (GramPEP.castDataQ externalPrimalQ) ∧
      (Profiles.ProximalGradient.objectiveQ 0).evalR (GramPEP.castDataQ externalPrimalQ) = 1 / 4 :=
⟨finite_universal_upper, external_primal_attainment⟩
