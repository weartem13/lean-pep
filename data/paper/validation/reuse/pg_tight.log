                          (Mathlib.Meta.NormNum.isNNRat_inv_pos
                            (Mathlib.Meta.NormNum.IsNat.to_isNNRat (Mathlib.Meta.NormNum.isNat_ofNat ℚ (Eq.refl 4))))
