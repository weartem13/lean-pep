LeanPEP.Toy.FiniteGD.ParametricUpper.gdGradientConstantSuffixQ_eq_tail_of_lt (N : ℕ) (r : Fin (N + 1)) (hr : ↑r < N) :
  LeanPEP.Toy.FiniteGD.ParametricUpper.gdGradientConstantSuffixQ N r =
    LeanPEP.Toy.FiniteGD.ParametricUpper.gdConstantTailQ N (↑r + 1)
LeanPEP.Toy.FiniteGD.ParametricUpper.gdGradientSuffixIdentityQ_of_lt (N : ℕ) (r : Fin (N + 1)) (hr : ↑r < N) :
  LeanPEP.Toy.FiniteGD.ParametricUpper.gdStarWeightQ N r +
      (LeanPEP.Toy.FiniteGD.ParametricUpper.gdGradientSquareContributionQ N r r -
        2 * LeanPEP.Toy.FiniteGD.ParametricUpper.gdGradientConstantSuffixQ N r) =
    0
LeanPEP.Toy.FiniteGD.ParametricUpper.gdGradientSuffixIdentityQ_all (N : ℕ) :
