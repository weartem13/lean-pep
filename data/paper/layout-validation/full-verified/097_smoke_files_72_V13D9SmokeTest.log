LeanPEP.Adapters.ProximalGradientCapture.checkTraceQ_eq_true_iff {n k : ℕ}
  (s : Adapters.ProximalGradientSparse.SourceQ n k) (t : TraceQ n k) :
  checkTraceQ s t = true ↔
    ExactReindexing.checkQ t.values = true ∧
      (∀ (i : Fin k), moveValuesQ t (t.rows i) = s.rows i) ∧
        moveValuesQ t t.objective = s.objective ∧
          (∀ (i : Fin k), (s.rules i).sense = RowNormalization.SenseQ.leZero ∧ (s.rules i).scale = 1) ∧
            Adapters.ProximalGradientSparse.checkSourceQ s = true
LeanPEP.Adapters.ProximalGradientCapture.captured_row_eval {n k : ℕ} (s : Adapters.ProximalGradientSparse.SourceQ n k)
  (t : TraceQ n k) (h : checkTraceQ s t = true) (i : Fin k)
  (d :
    DataR (Fin (Adapters.ProximalGradientOrdering.valueCount n + 1)) (Adapters.ProximalGradientOrdering.basisCount n)) :
  (s.rows i).evalR
      (ExactReindexing.dataR t.values
        (ExactReindexing.IndexMapQ.identity (Adapters.ProximalGradientOrdering.basisCount n)) d) =
    (t.rows i).evalR d
LeanPEP.Adapters.ProximalGradientCapture.captured_objective_eval {n k : ℕ}
  (s : Adapters.ProximalGradientSparse.SourceQ n k) (t : TraceQ n k) (h : checkTraceQ s t = true)
  (d :
    DataR (Fin (Adapters.ProximalGradientOrdering.valueCount n + 1)) (Adapters.ProximalGradientOrdering.basisCount n)) :
  s.objective.evalR
      (ExactReindexing.dataR t.values
        (ExactReindexing.IndexMapQ.identity (Adapters.ProximalGradientOrdering.basisCount n)) d) =
    t.objective.evalR d
LeanPEP.Adapters.ProximalGradientCapture.checkRawBindingQ_eq_true_iff {n k : ℕ}
  (s : Adapters.ProximalGradientSparse.SourceQ n k) (t : TraceQ n k) (raw : UpperCertQ s.model) :
  checkRawBindingQ s t raw = true ↔
    raw.bound = t.bound ∧
      raw.objective = moveValuesQ t t.objective ∧
        raw.interpTerms = [] ∧ orderedWeightsQ raw = traceWeightsQ t ∧ raw.dualMatrix = t.residual
LeanPEP.Adapters.ProximalGradientCapture.captured_numerics_preserved {n k : ℕ}
  (s : Adapters.ProximalGradientSparse.SourceQ n k) (t : TraceQ n k) (raw : UpperCertQ s.model)
  (h : checkRawBindingQ s t raw = true) :
  raw.bound = t.bound ∧ orderedWeightsQ raw = traceWeightsQ t ∧ raw.dualMatrix = t.residual
LeanPEP.Adapters.ProximalGradientCapture.checkCapturedQ_eq_true_iff {n k : ℕ}
  (s : Adapters.ProximalGradientSparse.SourceQ n k) (t : TraceQ n k) (policy : PolicyQ)
  (raw reconstructed : UpperCertQ s.model) :
  checkCapturedQ s t policy raw reconstructed = true ↔
    checkTraceQ s t = true ∧
      checkRawBindingQ s t raw = true ∧
        Adapters.ProximalGradientReconstruction.checkReconstructedQ s policy raw reconstructed = true
LeanPEP.Adapters.ProximalGradientCapture.checkCapturedRawQ_eq_true_iff {n k : ℕ}
  (s : Adapters.ProximalGradientSparse.SourceQ n k) (t : TraceQ n k) (raw : UpperCertQ s.model) :
  checkCapturedRawQ s t raw = true ↔
    checkTraceQ s t = true ∧
      checkRawBindingQ s t raw = true ∧ Adapters.ProximalGradientReconstruction.checkRawQ s raw = true
LeanPEP.Adapters.ProximalGradientCapture.reconstructed_check {n k : ℕ} (s : Adapters.ProximalGradientSparse.SourceQ n k)
  (t : TraceQ n k) (policy : PolicyQ) (raw reconstructed : UpperCertQ s.model)
  (h : checkCapturedQ s t policy raw reconstructed = true) :
  Adapters.ProximalGradientReconstruction.checkReconstructedQ s policy raw reconstructed = true
LeanPEP.Adapters.ProximalGradientCapture.captured_raw_check {n k : ℕ} (s : Adapters.ProximalGradientSparse.SourceQ n k)
  (t : TraceQ n k) (raw : UpperCertQ s.model) (h : checkCapturedRawQ s t raw = true) :
  Adapters.ProximalGradientReconstruction.checkRawQ s raw = true
LeanPEP.Adapters.ProximalGradientCapture.checked_certificate {n k : ℕ} (s : Adapters.ProximalGradientSparse.SourceQ n k)
  (t : TraceQ n k) (policy : PolicyQ) (raw reconstructed : UpperCertQ s.model)
  (h : checkCapturedQ s t policy raw reconstructed = true) :
  ∃ d,
    checkUpperCertQ d = true ∧
      d.interpTerms = [] ∧ d.objective = Profiles.ProximalGradient.objectiveQ n ∧ d.bound = reconstructed.bound
