LeanPEP.GramPEP.PerformanceLift.substitute_embed {p m : ℕ} (o e : LinearExprQ p m) : substituteQ o (embedExprQ e) = e
LeanPEP.GramPEP.PerformanceLift.substitute_tau {p m : ℕ} (o : LinearExprQ p m) : substituteQ o (tauExprQ p m) = o
LeanPEP.GramPEP.PerformanceLift.substitute_add {p m : ℕ} (o : LinearExprQ p m) (e f : LinearExprQ (p + 1) m) :
  substituteQ o (e.add f) = (substituteQ o e).add (substituteQ o f)
LeanPEP.GramPEP.PerformanceLift.substitute_scale {p m : ℕ} (o : LinearExprQ p m) (a : ℚ) (e : LinearExprQ (p + 1) m) :
  substituteQ o (LinearExprQ.scale a e) = LinearExprQ.scale a (substituteQ o e)
LeanPEP.GramPEP.PerformanceLift.substitute_link {p m : ℕ} (o : LinearExprQ p m) :
  substituteQ o (linkExprQ o) = LinearExprQ.zero p m
LeanPEP.GramPEP.PerformanceLift.eval_embed {p m : ℕ} (e : LinearExprQ p m) (d : DataR (Fin p) m) (t : ℝ) :
  (embedExprQ e).evalR (extendDataR d t) = e.evalR d
LeanPEP.GramPEP.PerformanceLift.eval_tau {p m : ℕ} (d : DataR (Fin p) m) (t : ℝ) :
  (tauExprQ p m).evalR (extendDataR d t) = t
LeanPEP.GramPEP.PerformanceLift.eval_substitute {p m : ℕ} (o : LinearExprQ p m) (e : LinearExprQ (p + 1) m)
  (d : DataR (Fin p) m) : (substituteQ o e).evalR d = e.evalR (extendDataR d (o.evalR d))
LeanPEP.GramPEP.PerformanceLift.eval_link {p m : ℕ} (o : LinearExprQ p m) (d : DataR (Fin p) m) (t : ℝ) :
  (linkExprQ o).evalR (extendDataR d t) = o.evalR d - t
LeanPEP.Adapters.ProximalGradientPerformance.checkLiftQ_eq_true_iff {n : ℕ} (s : SourceQ n) :
  checkLiftQ s = true ↔
    0 < s.performanceRule.scale ∧
      (∀ (i : Fin (Adapters.ProximalGradientOrdering.rowCount n + 1)),
          s.rows i = expectedRowsQ s.base s.performanceRule i) ∧
        s.objective =
          tauExprQ (Adapters.ProximalGradientOrdering.valueCount n) (Adapters.ProximalGradientOrdering.basisCount n)
LeanPEP.Adapters.ProximalGradientPerformance.checkSourceQ_eq_true_iff {n : ℕ} (s : SourceQ n) :
  checkSourceQ s = true ↔ Adapters.ProximalGradientRows.checkSourceQ s.base = true ∧ checkLiftQ s = true
LeanPEP.Adapters.ProximalGradientPerformance.rows_feasible_iff {n : ℕ} (s : SourceQ n) (hs : checkLiftQ s = true)
  (d : DataR (Fin (Adapters.ProximalGradientOrdering.valueCount n)) (Adapters.ProximalGradientOrdering.basisCount n))
  (t : ℝ) :
  (∀ (i : Fin (Adapters.ProximalGradientOrdering.rowCount n + 1)), 0 ≤ (orientedRowQ s i).evalR (extendDataR d t)) ↔
    (∀ (i : Fin (Adapters.ProximalGradientOrdering.rowCount n)),
        RowNormalization.HoldsR (s.base.rules i).sense (s.base.snapshot.constraints i) d) ∧
      t ≤ s.base.snapshot.objective.evalR d
LeanPEP.Adapters.ProximalGradientPerformance.finite_upper_equivalence {n : ℕ} (s : SourceQ n) (hs : checkLiftQ s = true)
  (B : ℝ) :
  (∀
      (d :
        DataR (Fin (Adapters.ProximalGradientOrdering.valueCount n)) (Adapters.ProximalGradientOrdering.basisCount n)),
      IsGramPosSemidef d.gram →
        (∀ (i : Fin (Adapters.ProximalGradientOrdering.rowCount n)),
            RowNormalization.HoldsR (s.base.rules i).sense (s.base.snapshot.constraints i) d) →
          s.base.snapshot.objective.evalR d ≤ B) ↔
    ∀
      (d :
        DataR (Fin (Adapters.ProximalGradientOrdering.valueCount n)) (Adapters.ProximalGradientOrdering.basisCount n))
      (t : ℝ),
      IsGramPosSemidef d.gram →
        (∀ (i : Fin (Adapters.ProximalGradientOrdering.rowCount n + 1)),
            0 ≤ (orientedRowQ s i).evalR (extendDataR d t)) →
          t ≤ B
LeanPEP.Adapters.ProximalGradientPerformance.assumption_sum_preserved {n : ℕ} (s : SourceQ n) (hs : checkLiftQ s = true)
  (ts : List (AssumptionTermQ s.model)) :
  substituteQ s.base.snapshot.objective (assumptionExprSumQ s.model ts) =
    assumptionExprSumQ s.base.model (eliminateTermsQ s ts)
LeanPEP.Adapters.ProximalGradientPerformance.certificate_rhs_preserved {n : ℕ} (s : SourceQ n)
  (hs : checkLiftQ s = true) (c : UpperCertQ s.model) (hi : c.interpTerms = []) :
  substituteQ s.base.snapshot.objective (certificateRhsExprQ c) = certificateRhsExprQ (eliminatedUpperQ s c)
LeanPEP.Adapters.ProximalGradientPerformance.eliminatedUpper_check {n : ℕ} (s : SourceQ n) (hs : checkLiftQ s = true)
  (c : UpperCertQ s.model) (hi : c.interpTerms = []) (hc : checkUpperCertQ c = true) :
  checkUpperCertQ (eliminatedUpperQ s c) = true
LeanPEP.Adapters.ProximalGradientPerformance.performance_mass_eq_one {n : ℕ} (s : SourceQ n) (hs : checkLiftQ s = true)
  (c : UpperCertQ s.model) (hi : c.interpTerms = [])
  (ho :
    c.objective =
      tauExprQ (Adapters.ProximalGradientOrdering.valueCount n) (Adapters.ProximalGradientOrdering.basisCount n))
  (hc : checkUpperCertQ c = true) : performanceMassQ s c.assumptionTerms = 1
LeanPEP.Adapters.ProximalGradientPerformance.checked_performance_mass {n : ℕ} (s : SourceQ n) (c : UpperCertQ s.model)
  (hc : checkBoundQ s c = true) : performanceMassQ s c.assumptionTerms = 1
LeanPEP.Adapters.ProximalGradientPerformance.checked_certificate {n : ℕ} (s : SourceQ n) (c : UpperCertQ s.model)
  (hc : checkBoundQ s c = true) :
  ∃ d,
    checkUpperCertQ d = true ∧
      d.interpTerms = [] ∧ d.objective = Profiles.ProximalGradient.objectiveQ n ∧ d.bound = c.bound
