LeanPEP.Adapters.ProximalGradientSource.checkSourceQ_eq_true_iff {n : ℕ} (s : SourceQ n) :
  checkSourceQ s = true ↔ s = expectedSourceQ n
LeanPEP.Adapters.ProximalGradientSource.source_model_eq {n : ℕ} (s : SourceQ n) (hs : checkSourceQ s = true) :
  s.model = Profiles.ProximalGradient.modelQ n
LeanPEP.Adapters.ProximalGradientSource.source_objective_eq {n : ℕ} (s : SourceQ n) (hs : checkSourceQ s = true) :
