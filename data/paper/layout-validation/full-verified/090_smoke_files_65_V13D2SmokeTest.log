LeanPEP.Adapters.ProximalGradientSource.checkBoundQ_eq_true_iff {n : ℕ} (s : SourceQ n) (c : UpperCertQ s.model) :
  checkBoundQ s c = true ↔
    checkSourceQ s = true ∧ checkUpperCertQ c = true ∧ c.interpTerms = [] ∧ c.objective = s.objective
LeanPEP.Adapters.ProximalGradientSource.checked_certificate {n : ℕ} (s : SourceQ n) (c : UpperCertQ s.model)
  (hc : checkBoundQ s c = true) :
  ∃ d,
    checkUpperCertQ d = true ∧
      d.interpTerms = [] ∧ d.objective = Profiles.ProximalGradient.objectiveQ n ∧ d.bound = c.bound
LeanPEP.Imported.CompositeSource.PGOne.bound_check : checkBoundQ PGOne.sourceQ PGOne.upperQ = true
LeanPEP.Imported.CompositeSource.PGTwo.bound_check : checkBoundQ PGTwo.sourceQ PGTwo.upperQ = true
LeanPEP.Imported.CompositeSource.PGThree.bound_check : checkBoundQ PGThree.sourceQ PGThree.upperQ = true
LeanPEP.Imported.CompositeSource.forged_local_certificate_accepted : checkUpperCertQ forgedUpperQ = true
LeanPEP.Imported.CompositeSource.forged_bound_rejected : checkBoundQ forgedSourceQ forgedUpperQ = false
