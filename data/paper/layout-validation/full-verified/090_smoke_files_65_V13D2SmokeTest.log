LeanPEP.Adapters.ExactFormulation.checkListQ_eq_true_iff.{u_1} {α : Type u_1} (cmp : α → α → Bool)
  (hcmp : ∀ (a b : α), cmp a b = true ↔ a = b) (xs ys : List α) :
  Adapters.ExactFormulation.checkListQ cmp xs ys = true ↔ xs = ys
