LeanPEP.ActualFunction.ParametricGDScaling.smoothGDIterate_succ.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] (L : ℝ≥0) (g : E → E) (x0 : E) (k : ℕ) :
  LeanPEP.ActualFunction.ParametricGDScaling.smoothGDIterate L g x0 (k + 1) =
    LeanPEP.ActualFunction.ParametricGDScaling.smoothGDIterate L g x0 k -
      (↑L)⁻¹ • g (LeanPEP.ActualFunction.ParametricGDScaling.smoothGDIterate L g x0 k)
LeanPEP.ActualFunction.IsSmoothConvexFirstOrder.parametricGD_upper_exact_radius.{u_1} {E : Type u_1}
  [NormedAddCommGroup E] [InnerProductSpace ℝ E] {L : ℝ≥0} {f : E → ℝ} {g : E → E}
  (h : LeanPEP.ActualFunction.IsSmoothConvexFirstOrder L f g) (hL : 0 < ↑L) (N : ℕ) {xStar x0 : E}
  (hstationary : g xStar = 0) :
  f (LeanPEP.ActualFunction.ParametricGDScaling.smoothGDIterate L g x0 N) - f xStar ≤
    ↑L * ‖x0 - xStar‖ ^ 2 * ↑(LeanPEP.Toy.FiniteGD.ParametricUpper.gdBoundQ N)
