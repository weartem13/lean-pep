LeanPEP.GramPEP.mem_gramAsymmetriesQ_sound {m : ℕ} (G : Gram m ℚ) (a : GramAsymmetryQ m) (h : a ∈ gramAsymmetriesQ G) :
  a.left = G a.i a.j ∧ a.right = G a.j a.i ∧ a.left ≠ a.right
LeanPEP.GramPEP.mem_negativeFactorWeightsQ_sound {m : ℕ} (c : PSDFactorCertQ m) (e : NegativeFactorWeightQ)
  (h : e ∈ negativeFactorWeightsQ c) : e.weight < 0
LeanPEP.GramPEP.mem_gramEntryMismatchesQ_sound {m : ℕ} (G actual : Gram m ℚ) (e : GramEntryMismatchQ m)
  (h : e ∈ gramEntryMismatchesQ G actual) : e.expected = G e.i e.j ∧ e.actual = actual e.i e.j ∧ e.expected ≠ e.actual
