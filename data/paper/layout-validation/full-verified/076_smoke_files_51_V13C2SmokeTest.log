LeanPEP.Profiles.ProximalGradient.modelQ_constraints (n : ℕ) :
  (Profiles.ProximalGradient.modelQ n).assumptions =
    List.flatMap
          (fun i =>
            List.map
              (fun j =>
                Profiles.Composite.interpolationExprQ Profiles.Composite.FunctionClassQ.oneSmoothConvex
                  (Profiles.ProximalGradient.smoothSamplesQ n i) (Profiles.ProximalGradient.smoothSamplesQ n j))
              (List.finRange (n + 3)))
          (List.finRange (n + 3)) ++
        List.flatMap
          (fun i =>
            List.map
              (fun j =>
                Profiles.Composite.interpolationExprQ Profiles.Composite.FunctionClassQ.convex
                  (Profiles.ProximalGradient.nonsmoothSamplesQ n i) (Profiles.ProximalGradient.nonsmoothSamplesQ n j))
              (List.finRange (n + 2)))
          (List.finRange (n + 2)) ++
      [Profiles.ProximalGradient.radiusExprQ n]
LeanPEP.Profiles.ProximalGradient.modelQ_constraint_count (n : ℕ) :
