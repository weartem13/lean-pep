LeanPEP.GramPEP.ZeroRowCoverage.checkMapQ_eq_true_iff {small full : ℕ} (a : ZeroRowCoverage.MapQ small full) :
  ZeroRowCoverage.checkMapQ a = true ↔
    (∀ (i : Fin small), a.fromFull (a.toFull i) = some i) ∧
      ∀ (j : Fin full) (i : Fin small), a.fromFull j = some i → a.toFull i = j
LeanPEP.GramPEP.ZeroRowCoverage.toFull_injective {small full : ℕ} (a : ZeroRowCoverage.MapQ small full)
  (ha : ZeroRowCoverage.checkMapQ a = true) : Function.Injective a.toFull
LeanPEP.GramPEP.ZeroRowCoverage.omitted_iff {small full : ℕ} (a : ZeroRowCoverage.MapQ small full)
  (ha : ZeroRowCoverage.checkMapQ a = true) (j : Fin full) : a.fromFull j = none ↔ ¬∃ i, a.toFull i = j
LeanPEP.GramPEP.ZeroRowCoverage.checkRowsQ_eq_true_iff {p m small full : ℕ} (a : ZeroRowCoverage.MapQ small full)
  (xs : Fin small → LinearExprQ p m) (ys : Fin full → LinearExprQ p m) :
  ZeroRowCoverage.checkRowsQ a xs ys = true ↔
    ZeroRowCoverage.checkMapQ a = true ∧
      (∀ (i : Fin small), xs i = ys (a.toFull i)) ∧ ∀ (j : Fin full), a.fromFull j = none → ys j = LinearExprQ.zero p m
LeanPEP.GramPEP.ZeroRowCoverage.feasible_iff {p m small full : ℕ} (a : ZeroRowCoverage.MapQ small full)
  (xs : Fin small → LinearExprQ p m) (ys : Fin full → LinearExprQ p m) (ha : ZeroRowCoverage.checkRowsQ a xs ys = true)
  (d : DataR (Fin p) m) : (∀ (i : Fin small), 0 ≤ (xs i).evalR d) ↔ ∀ (j : Fin full), 0 ≤ (ys j).evalR d
LeanPEP.GramPEP.ZeroRowCoverage.finite_upper_equivalence {p m small full : ℕ} (a : ZeroRowCoverage.MapQ small full)
  (xs : Fin small → LinearExprQ p m) (ys : Fin full → LinearExprQ p m) (ha : ZeroRowCoverage.checkRowsQ a xs ys = true)
  (o : LinearExprQ p m) (B : ℝ) :
  (∀ (d : DataR (Fin p) m), IsGramPosSemidef d.gram → (∀ (i : Fin small), 0 ≤ (xs i).evalR d) → o.evalR d ≤ B) ↔
    ∀ (d : DataR (Fin p) m), IsGramPosSemidef d.gram → (∀ (j : Fin full), 0 ≤ (ys j).evalR d) → o.evalR d ≤ B
LeanPEP.Adapters.ProximalGradientSparse.checkCoverageQ_eq_true_iff {n k : ℕ} (s : SourceQ n k) :
  checkCoverageQ s = true ↔
    ZeroRowCoverage.checkRowsQ s.coverage s.rows (completedSourceQ s).rows = true ∧
      (∀ (i : Fin k),
          s.rules i = Adapters.ProximalGradientPerformance.rowRuleQ (completedSourceQ s) (s.coverage.toFull i)) ∧
        ∀ (i : Fin k), s.labels i = fullLabelQ s (s.coverage.toFull i)
LeanPEP.Adapters.ProximalGradientSparse.checkSourceQ_eq_true_iff {n k : ℕ} (s : SourceQ n k) :
  checkSourceQ s = true ↔
    checkCoverageQ s = true ∧ Adapters.ProximalGradientPerformance.checkSourceQ (completedSourceQ s) = true
LeanPEP.Adapters.ProximalGradientSparse.retained_row_eq {n k : ℕ} (s : SourceQ n k) (hs : checkCoverageQ s = true)
  (i : Fin k) :
  orientedRowQ s i = Adapters.ProximalGradientPerformance.orientedRowQ (completedSourceQ s) (s.coverage.toFull i)
LeanPEP.Adapters.ProximalGradientSparse.omitted_row_zero {n k : ℕ} (s : SourceQ n k) (hs : checkCoverageQ s = true)
  (j : Fin (Adapters.ProximalGradientOrdering.rowCount n + 1)) (hj : s.coverage.fromFull j = none) :
  Adapters.ProximalGradientPerformance.orientedRowQ (completedSourceQ s) j =
    LinearExprQ.zero (Adapters.ProximalGradientOrdering.valueCount n + 1)
      (Adapters.ProximalGradientOrdering.basisCount n)
LeanPEP.Adapters.ProximalGradientSparse.oriented_coverage_check {n k : ℕ} (s : SourceQ n k)
  (hs : checkCoverageQ s = true) :
  ZeroRowCoverage.checkRowsQ s.coverage (orientedRowQ s)
      (Adapters.ProximalGradientPerformance.orientedRowQ (completedSourceQ s)) =
    true
LeanPEP.Adapters.ProximalGradientSparse.rows_feasible_iff {n k : ℕ} (s : SourceQ n k) (hs : checkCoverageQ s = true)
  (d :
    DataR (Fin (Adapters.ProximalGradientOrdering.valueCount n + 1)) (Adapters.ProximalGradientOrdering.basisCount n)) :
  (∀ (i : Fin k), 0 ≤ (orientedRowQ s i).evalR d) ↔
    ∀ (j : Fin (Adapters.ProximalGradientOrdering.rowCount n + 1)),
      0 ≤ (Adapters.ProximalGradientPerformance.orientedRowQ (completedSourceQ s) j).evalR d
LeanPEP.Adapters.ProximalGradientSparse.finite_upper_equivalence {n k : ℕ} (s : SourceQ n k)
  (hs : checkCoverageQ s = true) (B : ℝ) :
  (∀
      (d :
        DataR (Fin (Adapters.ProximalGradientOrdering.valueCount n + 1))
          (Adapters.ProximalGradientOrdering.basisCount n)),
      IsGramPosSemidef d.gram → (∀ (i : Fin k), 0 ≤ (orientedRowQ s i).evalR d) → s.objective.evalR d ≤ B) ↔
    ∀
      (d :
        DataR (Fin (Adapters.ProximalGradientOrdering.valueCount n + 1))
          (Adapters.ProximalGradientOrdering.basisCount n)),
      IsGramPosSemidef d.gram →
        (∀ (j : Fin (Adapters.ProximalGradientOrdering.rowCount n + 1)),
            0 ≤ (Adapters.ProximalGradientPerformance.orientedRowQ (completedSourceQ s) j).evalR d) →
          s.objective.evalR d ≤ B
LeanPEP.Adapters.ProximalGradientSparse.completedTermQ_weight {n k : ℕ} (s : SourceQ n k)
  (t : AssumptionTermQ s.model) : (completedTermQ s t).weight = t.weight
LeanPEP.Adapters.ProximalGradientSparse.completedTermQ_index {n k : ℕ} (s : SourceQ n k) (t : AssumptionTermQ s.model) :
  ↑(completedTermQ s t).index = ↑(s.coverage.toFull (sourceRowQ s t))
LeanPEP.Adapters.ProximalGradientSparse.assumption_sum_preserved {n k : ℕ} (s : SourceQ n k)
  (hs : checkCoverageQ s = true) (ts : List (AssumptionTermQ s.model)) :
  assumptionExprSumQ (completedSourceQ s).model (List.map (completedTermQ s) ts) = assumptionExprSumQ s.model ts
LeanPEP.Adapters.ProximalGradientSparse.certificate_rhs_preserved {n k : ℕ} (s : SourceQ n k)
  (hs : checkCoverageQ s = true) (c : UpperCertQ s.model) (hi : c.interpTerms = []) :
  certificateRhsExprQ (completedUpperQ s c) = certificateRhsExprQ c
LeanPEP.Adapters.ProximalGradientSparse.completedUpper_check {n k : ℕ} (s : SourceQ n k) (hs : checkCoverageQ s = true)
  (c : UpperCertQ s.model) (hi : c.interpTerms = []) (hc : checkUpperCertQ c = true) :
  checkUpperCertQ (completedUpperQ s c) = true
LeanPEP.Adapters.ProximalGradientSparse.completedUpperQ_count {n k : ℕ} (s : SourceQ n k) (c : UpperCertQ s.model) :
  (completedUpperQ s c).assumptionTerms.length = c.assumptionTerms.length
LeanPEP.Adapters.ProximalGradientSparse.checked_certificate {n k : ℕ} (s : SourceQ n k) (c : UpperCertQ s.model)
  (hc : checkBoundQ s c = true) :
  ∃ d,
