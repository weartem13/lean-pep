LeanPEP.GramPEP.NegativeInterpWeightQ (p : ℕ) : Type
LeanPEP.GramPEP.NegativeAssumptionWeightQ : Type
LeanPEP.GramPEP.LinearCoeffLocationQ (p m : ℕ) : Type
LeanPEP.GramPEP.LinearCoeffMismatchQ (p m : ℕ) : Type
LeanPEP.GramPEP.UpperCertAuditReportQ (p m : ℕ) : Type
LeanPEP.GramPEP.auditUpperCertQ {p m : ℕ} {model : ModelQ p m} (c : UpperCertQ model) : UpperCertAuditReportQ p m
LeanPEP.GramPEP.auditUpperCertQ_accepted_iff {p m : ℕ} {model : ModelQ p m} (c : UpperCertQ model) :
  (auditUpperCertQ c).accepted = true ↔ UpperCertValidQ c
LeanPEP.GramPEP.auditUpperCertQ_sound_real {p m : ℕ} {model : ModelQ p m} (c : UpperCertQ model)
  (haudit : (auditUpperCertQ c).accepted = true) (d : DataR (Fin p) m) (hrealizes : RealizesModelQ model d)
  (hcore : CoreFeasible d) (hassumptions : AssumptionsFeasibleR model d) : c.objective.evalR d ≤ ↑c.bound
LeanPEP.GramPEP.mem_negativeInterpWeightsQ_sound {p : ℕ} (terms : List (InterpTermQ p)) (e : NegativeInterpWeightQ p)
  (h : e ∈ negativeInterpWeightsQ terms) : e.weight < 0
LeanPEP.GramPEP.mem_negativeAssumptionWeightsQ_sound {p m : ℕ} {model : ModelQ p m}
  (terms : List (AssumptionTermQ model)) (e : NegativeAssumptionWeightQ) (h : e ∈ negativeAssumptionWeightsQ terms) :
  e.weight < 0
LeanPEP.GramPEP.mem_linearExprMismatchesQ_sound {p m : ℕ} (expected actual : LinearExprQ p m)
  (e : LinearCoeffMismatchQ p m) (h : e ∈ linearExprMismatchesQ expected actual) :
  e.expected = linearCoeffAtQ expected e.location ∧ e.actual = linearCoeffAtQ actual e.location ∧ e.expected ≠ e.actual
