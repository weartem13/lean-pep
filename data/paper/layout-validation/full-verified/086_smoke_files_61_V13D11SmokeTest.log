LeanPEP.GramPEP.RationalBoxSystem.checkFeasibleQ_eq_true_iff {r c : ℕ} (s : BoxQ r c) (x : Fin c → ℚ) :
  checkFeasibleQ s x = true ↔ FeasibleQ s x
LeanPEP.GramPEP.RationalBoxSystem.checkObstructionQ_eq_true_iff {r c : ℕ} (s : BoxQ r c) (w : ObstructionQ r c) :
  checkObstructionQ s w = true ↔ IsObstructionQ s w
LeanPEP.GramPEP.RationalBoxSystem.margin_eq_slacks {r c : ℕ} (s : BoxQ r c) (w : ObstructionQ r c) (x : Fin c → ℚ)
  (hx : RationalLinearSystem.IsSolutionQ s.system x)
  (hcancel : ∀ (j : Fin c), ∑ i, w.equality i * s.system.matrix i j + w.upper j - w.lower j = 0) :
  marginQ s w = ∑ j, (w.lower j * (x j - s.lower j) + w.upper j * (s.upper j - x j))
LeanPEP.GramPEP.RationalBoxSystem.obstruction_not_feasible {r c : ℕ} (s : BoxQ r c) (w : ObstructionQ r c)
  (hw : IsObstructionQ s w) : ¬∃ x, FeasibleQ s x
LeanPEP.GramPEP.RationalBoxSystem.checked_obstruction {r c : ℕ} (s : BoxQ r c) (w : ObstructionQ r c)
  (hw : checkObstructionQ s w = true) : ¬∃ x, FeasibleQ s x
LeanPEP.GramPEP.RationalBoxSystem.policy_interval_iff {c : ℕ} (raw : Fin c → ℚ) (eta : ℚ) (nonnegative : Fin c → Bool)
  (j : Fin c) (v : ℚ) :
  policyLowerQ raw eta nonnegative j ≤ v ∧ v ≤ policyUpperQ raw eta j ↔
    |v - raw j| ≤ eta ∧ (nonnegative j = true → 0 ≤ v)
LeanPEP.GramPEP.RationalBoxSystem.policy_box_iff {r c : ℕ} (s : RationalLinearSystem.SystemQ r c) (raw x : Fin c → ℚ)
  (eta : ℚ) (nonnegative : Fin c → Bool) :
  FeasibleQ { system := s, lower := policyLowerQ raw eta nonnegative, upper := policyUpperQ raw eta } x ↔
    RationalLinearSystem.IsSolutionQ s x ∧ ∀ (j : Fin c), |x j - raw j| ≤ eta ∧ (nonnegative j = true → 0 ≤ x j)
LeanPEP.Imported.CompositeBoundedCompletion.PGOne.raw_vector_check :
  List.ofFn Imported.CompositeBoundedCompletion.PGOne.rawVectorQ =
    Imported.CompositeBoundedCompletion.PGOne.rawUpperQ.bound ::
      List.map (fun t => t.weight) Imported.CompositeBoundedCompletion.PGOne.rawUpperQ.assumptionTerms
LeanPEP.Imported.CompositeBoundedCompletion.PGOne.completion_vector_check :
  List.ofFn Imported.CompositeBoundedCompletion.PGOne.completionVectorQ =
    Imported.CompositeBoundedCompletion.PGOne.completedUpperQ.bound ::
      List.map (fun t => t.weight) Imported.CompositeBoundedCompletion.PGOne.completedUpperQ.assumptionTerms
