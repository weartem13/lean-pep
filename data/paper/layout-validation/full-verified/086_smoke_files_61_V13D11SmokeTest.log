LeanPEP.Imported.CompositeBoundedCompletion.PGThree.box_bounds_check :
  Imported.CompositeBoundedCompletion.PGThree.boxQ.lower =
      policyLowerQ Imported.CompositeBoundedCompletion.PGThree.rawVectorQ
        Imported.CompositeBoundedCompletion.PGThree.policyQ.maxAbsError
        Imported.CompositeBoundedCompletion.PGThree.signMaskQ ∧
    Imported.CompositeBoundedCompletion.PGThree.boxQ.upper =
      policyUpperQ Imported.CompositeBoundedCompletion.PGThree.rawVectorQ
        Imported.CompositeBoundedCompletion.PGThree.policyQ.maxAbsError
LeanPEP.Imported.CompositeBoundedCompletion.PGThree.box_feasible_check :
  checkFeasibleQ Imported.CompositeBoundedCompletion.PGThree.boxQ
      Imported.CompositeBoundedCompletion.PGThree.completionVectorQ =
    true
LeanPEP.Imported.CompositeBoundedCompletion.PGThree.completed_check :
