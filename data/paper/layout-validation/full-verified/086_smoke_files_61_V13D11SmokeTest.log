LeanPEP.ActualFunction.ProximalGradientCompletionAudit.upper_analytic.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] [CompleteSpace E] {n k : ℕ} (s : Adapters.ProximalGradientSparse.SourceQ n k)
  (t : Adapters.ProximalGradientCapture.TraceQ n k) (policy : RationalReconstructionAudit.PolicyQ)
  (raw seed completed : UpperCertQ s.model)
  (hc : Adapters.ProximalGradientCompletion.checkCompletedQ s t policy raw seed completed = true) {L : ℝ≥0} {R : ℝ}
  {f h : E → ℝ} {g : E → E} {xStar : E} {x : ℕ → E} (hf : ActualFunction.IsSmoothConvexAnalytic L f g)
  (hh : ConvexOn ℝ Set.univ h) (hL : 0 < ↑L) (hR : 0 ≤ R) (hmin : ∀ (y : E), f xStar + h xStar ≤ f y + h y)
  (hrun : ActualFunction.ProximalGradientScaling.IsSmoothProxRun (n + 1) L h g x)
  (hradius : ‖x 0 - xStar‖ ^ 2 ≤ R ^ 2) :
  f (x (n + 1)) + h (x (n + 1)) - (f xStar + h xStar) ≤ ↑L * R ^ 2 * ↑completed.bound
LeanPEP.ActualFunction.ProximalGradientBoundedCompletionAudit.three_step_upper.{u_1} {E : Type u_1}
  [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] {L : ℝ≥0} {R : ℝ} {f h : E → ℝ} {g : E → E}
  {xStar : E} {x : ℕ → E} (hf : ActualFunction.IsSmoothConvexAnalytic L f g) (hh : ConvexOn ℝ Set.univ h) (hL : 0 < ↑L)
  (hR : 0 ≤ R) (hmin : ∀ (y : E), f xStar + h xStar ≤ f y + h y)
  (hrun : ActualFunction.ProximalGradientScaling.IsSmoothProxRun 3 L h g x) (hradius : ‖x 0 - xStar‖ ^ 2 ≤ R ^ 2) :
  f (x 3) + h (x 3) - (f xStar + h xStar) ≤ ↑L * R ^ 2 / 12
