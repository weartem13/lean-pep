LeanPEP.Profiles.Composite.rowMajorList_getElem?.{u_1} {α : Type u_1} (r c : ℕ) (f : Fin r → Fin c → α) (i : Fin r)
  (j : Fin c) : (Profiles.Composite.rowMajorList r c f)[↑i * c + ↑j]? = some (f i j)
LeanPEP.Profiles.ProximalGradientCertificate.smoothIndex_get (n : ℕ) (i j : Fin (n + 3)) :
  (Profiles.ProximalGradient.modelQ n).assumptions.get (smoothIndex n i j) =
    Profiles.Composite.interpolationExprQ Profiles.Composite.FunctionClassQ.oneSmoothConvex
      (Profiles.ProximalGradient.smoothSamplesQ n i) (Profiles.ProximalGradient.smoothSamplesQ n j)
LeanPEP.Profiles.ProximalGradientCertificate.nonsmoothIndex_get (n : ℕ) (i j : Fin (n + 2)) :
  (Profiles.ProximalGradient.modelQ n).assumptions.get (nonsmoothIndex n i j) =
    Profiles.Composite.interpolationExprQ Profiles.Composite.FunctionClassQ.convex
      (Profiles.ProximalGradient.nonsmoothSamplesQ n i) (Profiles.ProximalGradient.nonsmoothSamplesQ n j)
LeanPEP.Profiles.ProximalGradientCertificate.radiusIndex_get (n : ℕ) :
  (Profiles.ProximalGradient.modelQ n).assumptions.get (radiusIndex n) = Profiles.ProximalGradient.radiusExprQ n
LeanPEP.Profiles.ProximalGradientCertificate.smoothStarWeightQ_flow (n : ℕ) (i : Fin (n + 2)) :
  smoothStarWeightQ n i = smoothFluxQ n i.succ - smoothFluxQ n i.castSucc
LeanPEP.Profiles.ProximalGradientCertificate.nonsmoothStarWeightQ_flow (n : ℕ) (i : Fin (n + 1)) :
  nonsmoothStarWeightQ n i = nodeFluxQ n (↑i + 1) - nodeFluxQ n ↑i
LeanPEP.Profiles.ProximalGradientCertificate.weighted_flux_sum.{u_1} {M : Type u_1} [AddCommGroup M] [Module ℚ M]
  (k : ℕ) (q : Fin (k + 2) → ℚ) (z : Fin (k + 1) → M) (hzero : q 0 = 0) (hlast : q (Fin.last (k + 1)) = 1) :
  ∑ i, (q i.succ - q i.castSucc) • z i = z (Fin.last k) + ∑ i, q i.succ.castSucc • (z i.castSucc - z i.succ)
LeanPEP.Profiles.ProximalGradientCertificate.smooth_weighted_sum.{u_1} {M : Type u_1} [AddCommGroup M] [Module ℚ M]
  (n : ℕ) (z : Fin (n + 2) → M) :
  ∑ i, smoothStarWeightQ n i • z i = z (Fin.last (n + 1)) + ∑ i, smoothChainWeightQ n i • (z i.castSucc - z i.succ)
LeanPEP.Profiles.ProximalGradientCertificate.nonsmooth_weighted_sum.{u_1} {M : Type u_1} [AddCommGroup M] [Module ℚ M]
  (n : ℕ) (z : Fin (n + 1) → M) :
  ∑ i, nonsmoothStarWeightQ n i • z i = z (Fin.last n) + ∑ i, nonsmoothChainWeightQ n i • (z i.castSucc - z i.succ)
LeanPEP.Profiles.ProximalGradientCertificate.smooth_value_balance (n : ℕ) (a : ℚ) (z : Fin (n + 2) → ℚ) :
  ∑ i, smoothStarWeightQ n i * (a - z i) + ∑ i, smoothChainWeightQ n i * (z i.castSucc - z i.succ) =
    a - z (Fin.last (n + 1))
LeanPEP.Profiles.ProximalGradientCertificate.nonsmooth_value_balance (n : ℕ) (a : ℚ) (z : Fin (n + 1) → ℚ) :
  ∑ i, nonsmoothStarWeightQ n i * (a - z i) + ∑ i, nonsmoothChainWeightQ n i * (z i.castSucc - z i.succ) =
    a - z (Fin.last n)
LeanPEP.GramPEP.CoefficientAlgebra.coefficients_injective {p m : ℕ} : Function.Injective CoefficientAlgebra.coefficients
LeanPEP.GramPEP.CoefficientAlgebra.coefficients_factorGramQ {p m : ℕ} (terms : List (RankOneFactorQ m)) :
  CoefficientAlgebra.coefficients (LinearExprQ.gramPairing (factorGramQ terms)) =
    (List.map (fun t => t.weight • CoefficientAlgebra.normSquare t.vector) terms).sum
LeanPEP.Profiles.ProximalGradientCertificate.potentialQ_zero (n : ℕ) : potentialQ n 0 = boundQ n
LeanPEP.Profiles.ProximalGradientCertificate.potentialQ_last (n : ℕ) : potentialQ n (n + 1) = 0
LeanPEP.Profiles.ProximalGradientCertificate.local_weight_identities (n : ℕ) (i : Fin (n + 1)) :
  mixedWeightQ n i - nodeFluxQ n ↑i = potentialQ n ↑i ∧
    mixedWeightQ n i * mixedRatioQ n i ^ 2 - nodeFluxQ n (↑i + 1) = -potentialQ n (↑i + 1) ∧
      2 * mixedWeightQ n i * mixedRatioQ n i = nodeFluxQ n ↑i + nodeFluxQ n (↑i + 1) ∧
        2 * mixedWeightQ n i * mixedGradientQ n i = smoothChainWeightQ n i ∧
          2 * mixedWeightQ n i * mixedRatioQ n i * mixedGradientQ n i = nodeFluxQ n (↑i + 1) ∧
            mixedWeightQ n i * mixedGradientQ n i ^ 2 + gradientDifferenceWeightQ n i = smoothChainWeightQ n i / 2
LeanPEP.Profiles.ProximalGradientCertificate.local_scalar_identity (n : ℕ) (i : Fin (n + 1)) (X Y G H : ℚ) :
  mixedWeightQ n i * (X - mixedRatioQ n i * Y - mixedGradientQ n i * (G - H)) ^ 2 +
            gradientDifferenceWeightQ n i * (G - H) ^ 2 +
          smoothChainWeightQ n i * ((G - H) * X - 1 / 2 * (G - H) ^ 2) +
        nodeFluxQ n (↑i + 1) * (X - Y - G) * Y -
      nodeFluxQ n ↑i * (X - Y - G) * X =
    potentialQ n ↑i * X ^ 2 - potentialQ n (↑i + 1) * Y ^ 2 + nodeFluxQ n ↑i * G * X - nodeFluxQ n (↑i + 1) * H * Y
LeanPEP.Profiles.ProximalGradientCertificate.local_gram_identity {p m : ℕ} (n : ℕ) (i : Fin (n + 1))
  (X Y G H : VecExpr m ℚ) :
  mixedWeightQ n i • CoefficientAlgebra.normSquare (X - mixedRatioQ n i • Y - mixedGradientQ n i • (G - H)) +
            gradientDifferenceWeightQ n i • CoefficientAlgebra.normSquare (G - H) +
          smoothChainWeightQ n i •
            (CoefficientAlgebra.bilinear (G - H) X - (1 / 2) • CoefficientAlgebra.normSquare (G - H)) +
        nodeFluxQ n (↑i + 1) • CoefficientAlgebra.bilinear (X - Y - G) Y -
      nodeFluxQ n ↑i • CoefficientAlgebra.bilinear (X - Y - G) X =
    potentialQ n ↑i • CoefficientAlgebra.normSquare X - potentialQ n (↑i + 1) • CoefficientAlgebra.normSquare Y +
        nodeFluxQ n ↑i • CoefficientAlgebra.bilinear G X -
      nodeFluxQ n (↑i + 1) • CoefficientAlgebra.bilinear H Y
LeanPEP.Profiles.ProximalGradientCertificate.fin_telescope.{u_1} {M : Type u_1} [AddCommGroup M] (k : ℕ)
  (z : Fin (k + 1) → M) : ∑ i, (z i.castSucc - z i.succ) = z 0 - z (Fin.last k)
LeanPEP.Profiles.ProximalGradientCertificate.smooth_component_balance.{u_1} {M : Type u_1} [AddCommGroup M] [Module ℚ M]
  (n : ℕ) (F K D : Fin (n + 2) → M) (C E : Fin (n + 1) → M) (Fstar : M) :
  ∑ i, smoothStarWeightQ n i • (Fstar - F i + K i - (1 / 2) • D i) +
        ∑ i, smoothChainWeightQ n i • (F i.castSucc - F i.succ - C i - (1 / 2) • E i) +
      ∑ i, (smoothStarWeightQ n i / 2) • D i =
    Fstar - F (Fin.last (n + 1)) + K (Fin.last (n + 1)) +
      ∑ i, smoothChainWeightQ n i • (K i.castSucc - K i.succ - C i - (1 / 2) • E i)
LeanPEP.Profiles.ProximalGradientCertificate.nonsmooth_component_balance.{u_1} {M : Type u_1} [AddCommGroup M]
  [Module ℚ M] (n : ℕ) (H A K : Fin (n + 1) → M) (Hstar : M) :
  ∑ i, nonsmoothStarWeightQ n i • (Hstar - H i + K i) +
      ∑ i, nonsmoothChainWeightQ n i • (H i.castSucc - H i.succ - (A i.succ - K i.succ)) =
    Hstar - H (Fin.last n) + ∑ i, (nodeFluxQ n (↑i + 1) • K i - nodeFluxQ n ↑i • A i)
LeanPEP.Profiles.ProximalGradientCertificate.certificateIdentityQ_all (n : ℕ) : CertificateIdentityQ n
LeanPEP.Profiles.ProximalGradientCertificate.upperCertQ_check_all (n : ℕ) : checkUpperCertQ (upperCertQ n) = true
LeanPEP.Profiles.ProximalGradientCertificate.upperCertQ_valid_all (n : ℕ) : UpperCertValidQ (upperCertQ n)
LeanPEP.ActualFunction.ProximalGradientRate.upper_all.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] {n : ℕ} {f h : E → ℝ} {g : E → E} {xStar : E} {x : ℕ → E}
  (hf : ActualFunction.IsOneSmoothConvexFirstOrder f g) (hh : ConvexOn ℝ Set.univ h)
  (hs : ActualFunction.Proximal.SubgradientAt h (-g xStar) xStar)
  (hrun : ActualFunction.ProximalGradient.IsProxRun (n + 1) h g x) (hradius : ‖x 0 - xStar‖ ^ 2 ≤ 1) :
  f (x (n + 1)) + h (x (n + 1)) - (f xStar + h xStar) ≤ 1 / (4 * (↑n + 1))
LeanPEP.ActualFunction.ProximalGradientRate.upper_analytic_all.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] [CompleteSpace E] {n : ℕ} {f h : E → ℝ} {g : E → E} {xStar : E} {x : ℕ → E}
  (hf : ActualFunction.IsOneSmoothConvexAnalytic f g) (hh : ConvexOn ℝ Set.univ h)
  (hs : ActualFunction.Proximal.SubgradientAt h (-g xStar) xStar)
  (hrun : ActualFunction.ProximalGradient.IsProxRun (n + 1) h g x) (hradius : ‖x 0 - xStar‖ ^ 2 ≤ 1) :
  f (x (n + 1)) + h (x (n + 1)) - (f xStar + h xStar) ≤ 1 / (4 * (↑n + 1))
LeanPEP.ActualFunction.ProximalGradientRate.upper_analytic_steps.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] [CompleteSpace E] (T : ℕ) (hT : 0 < T) {f h : E → ℝ} {g : E → E} {xStar : E} {x : ℕ → E}
  (hf : ActualFunction.IsOneSmoothConvexAnalytic f g) (hh : ConvexOn ℝ Set.univ h)
  (hs : ActualFunction.Proximal.SubgradientAt h (-g xStar) xStar)
  (hrun : ActualFunction.ProximalGradient.IsProxRun T h g x) (hradius : ‖x 0 - xStar‖ ^ 2 ≤ 1) :
  f (x T) + h (x T) - (f xStar + h xStar) ≤ 1 / (4 * ↑T)
LeanPEP.ActualFunction.ProximalGradientRate.finite_tight_all (n : ℕ) :
  IsGreatest (Profiles.ProximalGradient.finiteValues n) (1 / (4 * (↑n + 1)))
LeanPEP.ActualFunction.ProximalGradientRate.analytic_tight_all (n : ℕ) :
  IsGreatest (ActualFunction.ProximalGradient.oneDimensionalAnalyticValues n) (1 / (4 * (↑n + 1)))
LeanPEP.ActualFunction.ProximalGradientRate.analytic_upper_and_oneDimensional_tight_all.{u_1} {E : Type u_1}
  [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] (n : ℕ) :
  (∀ {f h : E → ℝ} {g : E → E} {xStar : E} {x : ℕ → E},
      ActualFunction.IsOneSmoothConvexAnalytic f g →
        ConvexOn ℝ Set.univ h →
          ActualFunction.Proximal.SubgradientAt h (-g xStar) xStar →
            ActualFunction.ProximalGradient.IsProxRun (n + 1) h g x →
              ‖x 0 - xStar‖ ^ 2 ≤ 1 → f (x (n + 1)) + h (x (n + 1)) - (f xStar + h xStar) ≤ 1 / (4 * (↑n + 1))) ∧
    IsGreatest (ActualFunction.ProximalGradient.oneDimensionalAnalyticValues n) (1 / (4 * (↑n + 1)))
