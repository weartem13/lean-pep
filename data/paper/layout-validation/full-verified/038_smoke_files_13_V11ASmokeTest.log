LeanPEP.GramPEP.ImportMetadataQ (p m : ℕ) : Type
LeanPEP.GramPEP.ExactGramBundleQ (p m : ℕ) : Type
LeanPEP.GramPEP.checkDataRealizesModelQ {p m : ℕ} (model : ModelQ p m) (d : DataQ (Fin p) m) : Bool
LeanPEP.GramPEP.checkInterpolationFeasibleQ {p m : ℕ} (d : DataQ (Fin p) m) : Bool
LeanPEP.GramPEP.checkAssumptionsFeasibleQ {p m : ℕ} (model : ModelQ p m) (d : DataQ (Fin p) m) : Bool
LeanPEP.GramPEP.checkExactGramBundleQ {p m : ℕ} (b : ExactGramBundleQ p m) : Bool
LeanPEP.GramPEP.checkExactGramBundleQ_sound_real {p m : ℕ} (b : ExactGramBundleQ p m)
  (h : checkExactGramBundleQ b = true) :
  checkImportMetadataQ b = true ∧
    RealizesModelQ b.model (castDataQ b.primal) ∧
      CoreFeasible (castDataQ b.primal) ∧
        AssumptionsFeasibleR b.model (castDataQ b.primal) ∧
          b.upper.objective.evalR (castDataQ b.primal) = ↑b.upper.bound ∧
            ∀ (d : DataR (Fin p) m),
              RealizesModelQ b.model d →
                CoreFeasible d → AssumptionsFeasibleR b.model d → b.upper.objective.evalR d ≤ ↑b.upper.bound
LeanPEP.GramPEP.ExactGramBundleAuditReportQ (p m : ℕ) : Type
LeanPEP.GramPEP.auditExactGramBundleQ {p m : ℕ} (b : ExactGramBundleQ p m) : ExactGramBundleAuditReportQ p m
LeanPEP.GramPEP.auditExactGramBundleQ_sound_real {p m : ℕ} (b : ExactGramBundleQ p m)
  (h : (auditExactGramBundleQ b).accepted = true) :
  checkImportMetadataQ b = true ∧
    RealizesModelQ b.model (castDataQ b.primal) ∧
      CoreFeasible (castDataQ b.primal) ∧
        AssumptionsFeasibleR b.model (castDataQ b.primal) ∧
          b.upper.objective.evalR (castDataQ b.primal) = ↑b.upper.bound ∧
            ∀ (d : DataR (Fin p) m),
              RealizesModelQ b.model d →
                CoreFeasible d → AssumptionsFeasibleR b.model d → b.upper.objective.evalR d ≤ ↑b.upper.bound
LeanPEP.GramPEP.checkPSDFactorQ_sound_real {m : ℕ} (G : Gram m ℚ) (c : PSDFactorCertQ m)
  (h : checkPSDFactorQ G c = true) : IsGramPosSemidef (castGramQ G)
LeanPEP.Imported.GramOneStepExact.bundleQ_check : checkExactGramBundleQ Imported.GramOneStepExact.bundleQ = true
LeanPEP.Imported.GramOneStepExact.bundleQ_sound_real :
  checkImportMetadataQ Imported.GramOneStepExact.bundleQ = true ∧
    RealizesModelQ Imported.GramOneStepExact.modelQ (castDataQ Imported.GramOneStepExact.primalQ) ∧
      CoreFeasible (castDataQ Imported.GramOneStepExact.primalQ) ∧
        AssumptionsFeasibleR Imported.GramOneStepExact.modelQ (castDataQ Imported.GramOneStepExact.primalQ) ∧
          Imported.GramOneStepExact.upperCertQ.objective.evalR (castDataQ Imported.GramOneStepExact.primalQ) =
              ↑Imported.GramOneStepExact.upperCertQ.bound ∧
            ∀ (d : DataR (Fin 3) 3),
              RealizesModelQ Imported.GramOneStepExact.modelQ d →
                CoreFeasible d →
                  AssumptionsFeasibleR Imported.GramOneStepExact.modelQ d →
                    Imported.GramOneStepExact.upperCertQ.objective.evalR d ≤ ↑Imported.GramOneStepExact.upperCertQ.bound
LeanPEP.Imported.GramOneStepBadMetadata.bundleQ_rejected :
  checkExactGramBundleQ Imported.GramOneStepBadMetadata.bundleQ = false
