  (s : ScheduleQ) (g : E → E) (x0 : E) : ℕ → E × E
LeanPEP.ActualFunction.MomentumActual.state_succ.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  (s : ScheduleQ) (g : E → E) (x0 : E) (k : ℕ) :
  MomentumActual.state s g x0 (k + 1) = MomentumActual.query s g x0 k - ↑(s.step k) • g (MomentumActual.query s g x0 k)
LeanPEP.ActualFunction.MomentumActual.query_succ.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  (s : ScheduleQ) (g : E → E) (x0 : E) (k : ℕ) :
  MomentumActual.query s g x0 (k + 1) =
    MomentumActual.state s g x0 (k + 1) +
      ↑(s.momentum k) • (MomentumActual.state s g x0 (k + 1) - MomentumActual.state s g x0 k)
LeanPEP.ActualFunction.MomentumActual.IsRun.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E] (N : ℕ)
  (s : ScheduleQ) (g : E → E) (x0 : E) (x y : ℕ → E) : Prop
LeanPEP.ActualFunction.MomentumActual.eq_of_isRun.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  {N : ℕ} {s : ScheduleQ} {g : E → E} {x0 : E} {x y : ℕ → E} (h : MomentumActual.IsRun N s g x0 x y) (k : ℕ) :
  k ≤ N → x k = MomentumActual.state s g x0 k ∧ y k = MomentumActual.query s g x0 k
LeanPEP.ActualFunction.MomentumActual.outputPoints_before_final.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] {N : ℕ} (s : ScheduleQ) (g : E → E) (x0 : E) (i : Fin (N + 1)) (hi : ↑i < N) :
  MomentumActual.outputPoints N s g x0 i = MomentumActual.query s g x0 ↑i
LeanPEP.ActualFunction.MomentumActual.outputPoints_final.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] (N : ℕ) (s : ScheduleQ) (g : E → E) (x0 : E) :
  MomentumActual.outputPoints N s g x0 (Fin.last N) = MomentumActual.state s g x0 N
LeanPEP.ActualFunction.MomentumActual.evalVector_stateAffineQ_succ.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] {N : ℕ} (s : ScheduleQ) (k : Fin (N + 1)) (u0 : E) (grad : Fin (N + 1) → E) :
  ParametricGDHilbert.evalVector (stateAffineQ N s (↑k + 1)) u0 grad =
    ParametricGDHilbert.evalVector (queryAffineQ N s ↑k) u0 grad - ↑(s.step ↑k) • grad k
LeanPEP.ActualFunction.MomentumActual.evalVector_queryAffineQ_succ.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] {N : ℕ} (s : ScheduleQ) (k : ℕ) (u0 : E) (grad : Fin (N + 1) → E) :
  ParametricGDHilbert.evalVector (queryAffineQ N s (k + 1)) u0 grad =
    ParametricGDHilbert.evalVector (stateAffineQ N s (k + 1)) u0 grad +
      ↑(s.momentum k) •
        (ParametricGDHilbert.evalVector (stateAffineQ N s (k + 1)) u0 grad -
          ParametricGDHilbert.evalVector (stateAffineQ N s k) u0 grad)
LeanPEP.ActualFunction.MomentumActual.affineTrajectory_realization.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] (N : ℕ) (s : ScheduleQ) (g : E → E) (xStar x0 : E) (k : ℕ) :
  k ≤ N →
    (ParametricGDHilbert.evalVector (stateAffineQ N s k) (x0 - xStar) fun i =>
          g (MomentumActual.outputPoints N s g x0 i)) =
        MomentumActual.state s g x0 k - xStar ∧
      (ParametricGDHilbert.evalVector (queryAffineQ N s k) (x0 - xStar) fun i =>
          g (MomentumActual.outputPoints N s g x0 i)) =
        MomentumActual.query s g x0 k - xStar
