LeanPEP.ActualFunction.NesterovPilotUpper.iterate_succ.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] (g : E → E) (x0 : E) (k : ℕ) :
  NesterovPilotUpper.iterate g x0 (k + 1) = NesterovPilotUpper.query g x0 k - g (NesterovPilotUpper.query g x0 k)
LeanPEP.ActualFunction.NesterovPilotUpper.query_succ.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  (g : E → E) (x0 : E) (k : ℕ) :
  NesterovPilotUpper.query g x0 (k + 1) =
