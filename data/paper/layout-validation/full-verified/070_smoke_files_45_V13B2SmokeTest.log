LeanPEP.ActualFunction.ProfileGram.profileData_interpolationSlack.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] {N : ℕ} (profile : PEPProfileQ N) (f : E → ℝ) (g : E → E) (xStar x0 : E)
  (points : Fin (N + 1) → E) (hstationary : g xStar = 0)
  (htrajectory : ProfileGram.RealizesProfile profile.algorithm g xStar x0 points) (i j : Fin (N + 2)) :
  GramPEP.interpolationSlack (ProfileGram.profileData profile f g xStar x0 points) i j =
    interpolationSlack f g (ProfileGram.orderedSamples xStar points i) (ProfileGram.orderedSamples xStar points j)
LeanPEP.ActualFunction.ProfileGram.profileData_coreFeasible.{u_1} {E : Type u_1} [NormedAddCommGroup E]
