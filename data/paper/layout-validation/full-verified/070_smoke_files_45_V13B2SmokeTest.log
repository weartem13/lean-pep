  {points : Fin (N + 1) → E} (hfun : IsOneSmoothConvexFirstOrder f g) (hstationary : g xStar = 0)
  (htrajectory : ProfileGram.RealizesProfile profile.algorithm g xStar x0 points) :
  GramPEP.CoreFeasible (ProfileGram.profileData profile f g xStar x0 points)
LeanPEP.ActualFunction.ProfileGram.profileData_initialRadius_eval.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] {N : ℕ} (profile : PEPProfileQ N) (f : E → ℝ) (g : E → E) (xStar x0 : E)
  (points : Fin (N + 1) → E) :
  (initialRadiusExprQ profile.normalization).evalR (ProfileGram.profileData profile f g xStar x0 points) =
    ↑profile.normalization.radiusSq - ‖x0 - xStar‖ ^ 2
LeanPEP.ActualFunction.ProfileGram.profileData_assumptionsFeasible.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] {N : ℕ} (profile : PEPProfileQ N) (f : E → ℝ) (g : E → E) (xStar x0 : E)
  (points : Fin (N + 1) → E) (hradius : ‖x0 - xStar‖ ^ 2 ≤ ↑profile.normalization.radiusSq) :
  GramPEP.AssumptionsFeasibleR (compileModelQ profile) (ProfileGram.profileData profile f g xStar x0 points)
LeanPEP.ActualFunction.ProfileGram.profileData_objective_eval.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] {N : ℕ} (profile : PEPProfileQ N) (f : E → ℝ) (g : E → E) (xStar x0 : E)
  (points : Fin (N + 1) → E) :
  (compileObjectiveQ profile).evalR (ProfileGram.profileData profile f g xStar x0 points) =
    f (ProfileGram.samplePoint xStar points profile.objective.target) -
      f (ProfileGram.samplePoint xStar points profile.objective.reference)
