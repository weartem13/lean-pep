LeanPEP.ActualFunction.ProfileGram.orderedSamples_pointIndex.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] {N : ℕ} (xStar : E) (points : Fin (N + 1) → E) (i : Toy.FiniteGD.Point N) :
  ProfileGram.orderedSamples xStar points (pointIndex i) = ProfileGram.samplePoint xStar points i
LeanPEP.ActualFunction.ProfileGram.realize_standardBasisQ.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] {m : ℕ} (base : Fin m → E) (i : Fin m) :
  FiniteGram.realize base (GramPEP.castVecQ (GramPEP.standardBasisExpr i)) = base i
LeanPEP.ActualFunction.ProfileGram.realize_affineVecQ.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] {N : ℕ} (a : Toy.FiniteGD.GradAffineQ N) (g : E → E) (xStar x0 : E)
  (points : Fin (N + 1) → E) :
  FiniteGram.realize (ProfileGram.sampleBase g xStar x0 points) (GramPEP.castVecQ (affineVecQ a)) =
    ParametricGDHilbert.evalVector a (x0 - xStar) fun i => g (points i)
LeanPEP.ActualFunction.ProfileGram.realize_initialBasisQ.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] {N : ℕ} (g : E → E) (xStar x0 : E) (points : Fin (N + 1) → E) :
  FiniteGram.realize (ProfileGram.sampleBase g xStar x0 points) (GramPEP.castVecQ (initialBasisQ N)) = x0 - xStar
LeanPEP.ActualFunction.ProfileGram.realize_sampledGradientBasisQ.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] {N : ℕ} (g : E → E) (xStar x0 : E) (points : Fin (N + 1) → E) (i : Fin (N + 1)) :
  FiniteGram.realize (ProfileGram.sampleBase g xStar x0 points) (GramPEP.castVecQ (sampledGradientBasisQ i)) =
    g (points i)
LeanPEP.ActualFunction.ProfileGram.RealizesProfile.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  {N : ℕ} (profile : Profiles.FixedStepFirstOrder.ProfileQ N) (g : E → E) (xStar x0 : E) (points : Fin (N + 1) → E) :
  Prop
LeanPEP.ActualFunction.ProfileGram.realizesProfile_iff_updates.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] {N : ℕ} (profile : Profiles.FixedStepFirstOrder.ProfileQ N) (g : E → E) (xStar x0 : E)
  (points : Fin (N + 1) → E) :
  ProfileGram.RealizesProfile profile g xStar x0 points ↔
    ∀ (i : Fin (N + 1)), points i = x0 - ∑ j, ↑(profile.stepCoeff i j) • g (points j)
LeanPEP.ActualFunction.ProfileGram.realizesActualSamples.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] {N : ℕ} (profile : PEPProfileQ N) (g : E → E) (xStar x0 : E) (points : Fin (N + 1) → E)
  (hstationary : g xStar = 0) (htrajectory : ProfileGram.RealizesProfile profile.algorithm g xStar x0 points) :
  FiniteGram.RealizesActualSamples (ProfileGram.sampleBase g xStar x0 points) (compileModelQ profile)
    (ProfileGram.orderedSamples xStar points) xStar g
