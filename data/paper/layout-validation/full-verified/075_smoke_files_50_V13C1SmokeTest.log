LeanPEP.Profiles.ProximalGradientOneStep.modelQ_constraints :
  Profiles.ProximalGradientOneStep.modelQ.assumptions =
    List.flatMap
          (fun i =>
            List.map
              (fun j =>
                Profiles.Composite.interpolationExprQ Profiles.Composite.FunctionClassQ.oneSmoothConvex
                  (Profiles.ProximalGradientOneStep.smoothSamplesQ i)
                  (Profiles.ProximalGradientOneStep.smoothSamplesQ j))
              (List.finRange 3))
          (List.finRange 3) ++
        List.flatMap
          (fun i =>
            List.map
              (fun j =>
                Profiles.Composite.interpolationExprQ Profiles.Composite.FunctionClassQ.convex
                  (Profiles.ProximalGradientOneStep.nonsmoothSamplesQ i)
                  (Profiles.ProximalGradientOneStep.nonsmoothSamplesQ j))
              (List.finRange 2))
          (List.finRange 2) ++
      [Profiles.ProximalGradientOneStep.radiusExprQ]
