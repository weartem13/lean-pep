  {p m : ℕ} {base : Fin m → E} {values : Fin p → ℝ} {anchor x y s t : E} {fx fy : ℝ}
  {a b : Profiles.Composite.SampleQ p m} (ha : Composite.SampleDenotes base values anchor a x s fx)
  (hb : Composite.SampleDenotes base values anchor b y t fy) :
  (Profiles.Composite.interpolationExprQ Profiles.Composite.FunctionClassQ.convex a b).evalR
