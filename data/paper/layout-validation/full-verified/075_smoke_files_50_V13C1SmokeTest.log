LeanPEP.Profiles.Composite.evalR_interpolationExprQ_convex {p m : ℕ} (a b : Profiles.Composite.SampleQ p m)
  (d : GramPEP.DataR (Fin p) m) (hG : GramPEP.IsGramSymmetric d.gram) :
  (Profiles.Composite.interpolationExprQ Profiles.Composite.FunctionClassQ.convex a b).evalR d =
    d.value a.valueIndex - d.value b.valueIndex -
      GramPEP.gramInner d.gram (GramPEP.castVecQ b.oracle) (GramPEP.castVecQ (a.position - b.position))
LeanPEP.Profiles.Composite.evalR_interpolationExprQ_smooth {p m : ℕ} (a b : Profiles.Composite.SampleQ p m)
  (d : GramPEP.DataR (Fin p) m) (hG : GramPEP.IsGramSymmetric d.gram) :
  (Profiles.Composite.interpolationExprQ Profiles.Composite.FunctionClassQ.oneSmoothConvex a b).evalR d =
    d.value a.valueIndex - d.value b.valueIndex -
        GramPEP.gramInner d.gram (GramPEP.castVecQ b.oracle) (GramPEP.castVecQ (a.position - b.position)) -
      1 / 2 * GramPEP.gramNormSq d.gram (GramPEP.castVecQ (a.oracle - b.oracle))
