    ↑(LeanPEP.Toy.FiniteGD.ParametricUpper.gdBoundQ N) * ‖x0 - xStar‖ ^ 2
LeanPEP.ActualFunction.IsOneSmoothConvexAnalytic.parametricGD_upper_unit_radius.{u_1} {E : Type u_1}
