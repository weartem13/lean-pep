theorem LeanPEP.ActualFunction.GDOneCapturedTightness.actual_tightness.{u_1} : ∀ {E : Type u_1}
  [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E] [inst_2 : CompleteSpace E] {L : NNReal} {R : ℝ},
  0 < ↑L →
    0 ≤ R →
      (∀ (f : E → ℝ) (g : E → E) (xStar x0 x1 : E),
          LeanPEP.ActualFunction.IsSmoothConvexAnalytic L f g →
            (∀ (y : E), f xStar ≤ f y) →
              x1 = x0 - (↑L)⁻¹ • g x0 → ‖x0 - xStar‖ ^ 2 ≤ R ^ 2 → f x1 - f xStar ≤ ↑L * R ^ 2 / 6) ∧
        ∃ f g xStar x0 x1,
          LeanPEP.ActualFunction.IsSmoothConvexAnalytic L f g ∧
            (∀ (y : ℝ), f xStar ≤ f y) ∧
              x1 = x0 - (↑L)⁻¹ • g x0 ∧ ‖x0 - xStar‖ ^ 2 ≤ R ^ 2 ∧ f x1 - f xStar = ↑L * R ^ 2 / 6 :=
fun {E} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] {L} {R} hL hR =>
  ⟨fun x x_1 x_2 x_3 x_4 hf hm hs hr => current_certificate_actual_upper hf hL hR hm hs hr,
    analytic_witness_verified hL hR⟩
