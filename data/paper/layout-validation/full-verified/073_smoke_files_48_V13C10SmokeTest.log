LeanPEP.ActualFunction.WeakFejerConvergence.fixed_defect_bound.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] {T : E → E} (hT : ∀ (x y : E), ‖T x - T y‖ ≤ ‖x - y‖) (x z : E) {B : ℝ} (hB : ‖x - z‖ ≤ B) :
  ‖T z - z‖ ^ 2 ≤ 2 * inner ℝ (x - z) (T z - z) + 2 * B * ‖T x - x‖ + ‖T x - x‖ ^ 2
